# Guard: abort if any tracked file contains known malware injection markers
# (obfuscated payloads, VS Code auto-run tasks, `node init` hooks)
if git grep --cached -nIE 'global\[|_\$_|sfL\(|parseInt\(0x|folderOpen|allowAutomaticTasks|node init' -- . ':!.husky' ':!*lock*'; then
  echo "SECURITY: malware injection markers found in the files above. Aborting commit."
  exit 1
fi
if git ls-files --cached | grep -E '^init$|^\.vscode/tasks\.json$|\.orc$'; then
  echo "SECURITY: known malware file is tracked (see above). Aborting commit."
  exit 1
fi

npx lint-staged
npm run typecheck
