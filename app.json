{
  "expo": {
    "name": "Dead Reckoner",
    "slug": "dead-reckoner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deadreckoner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mcboll.deadreckoner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#5F6D76"
      },
      "package": "com.mcboll.deadreckoner",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#5F6D76"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "es", "fr"],
            "android": ["en", "es", "fr"]
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/unbounded/200ExtraLight/Unbounded_200ExtraLight.ttf",
            "node_modules/@expo-google-fonts/unbounded/300Light/Unbounded_300Light.ttf",
            "node_modules/@expo-google-fonts/unbounded/400Regular/Unbounded_400Regular.ttf",
            "node_modules/@expo-google-fonts/unbounded/700Bold/Unbounded_700Bold.ttf",
            "node_modules/@expo-google-fonts/unbounded/600SemiBold/Unbounded_600SemiBold.ttf"
          ]
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          // TODO: remove this test account id
          "iosUrlScheme": "com.googleusercontent.apps.734448856073-6v14fmhdrf4svu697tpol30kmcrtjhqg"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f705a6d0-838c-4b3c-92a4-d3af418ef3d8"
      }
    },
    "owner": "dead-reckoner"
  }
}
