  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "approve-builds": "npx pnpm@10 approve-builds",
    "format": "prettier --write .",
    "prepare": "husky",
